# --- Database Configuration ---
POSTGRES_USER=epcis_user
POSTGRES_PASSWORD=FactorySecurePassword123!
POSTGRES_DB=epcis_prod_db

# --- Flask Configuration ---
FLASK_APP=run.py
FLASK_ENV=production
# Generate a real random key for production (e.g., `openssl rand -hex 32`)
SECRET_KEY=dev-secret-key-replace-in-production

# --- Security ---
# Secret used to sign JWT tokens for human login
JWT_SECRET_KEY=jwt-secret-key-replace-in-production
# Master key to create the first admin user (see auth.py)
ADMIN_SETUP_SECRET=super-secret-setup-key

# --- GS1 / Business Logic ---
# Your GS1 Company Prefix (GCP)
COMPANY_PREFIX=1234567
